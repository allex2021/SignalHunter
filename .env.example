# ==============================================================================
# CRYPTO SIGNAL AGGREGATOR — Environment Configuration
# Copy this file to .env and fill in your values.
# All free-tier API keys — no paid subscriptions required.
# ==============================================================================

# --- Module 1: AI Brain Gateway ---
# Gemini: https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash-latest

# Groq: https://console.groq.com/ (free tier, fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Mistral: https://console.mistral.ai/ (free tier)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# AI Brain Gateway internal port
AI_BRAIN_PORT=3000

# --- Module 2: Ingestion Agents ---
# GitHub: https://github.com/settings/tokens (no scopes needed for public events)
GITHUB_TOKEN=your_github_token_here

# Ethereum RPC — Ankr public free node (no key needed)
ETH_RPC_URL=https://rpc.ankr.com/eth
# Optional: Infura/Alchemy free tier for fallback
ETH_RPC_FALLBACK_URL=https://ethereum.publicnode.com

# USDT contract address (Mainnet)
USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
# USDC contract address (Mainnet)
USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Whale detection threshold (USD)
WHALE_THRESHOLD_USD=1000000

# --- Module 3: Social Mining ---
# Reddit API: https://www.reddit.com/prefs/apps (free)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=CryptoSignalBot/1.0 by YourRedditUsername
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Twitter/X: Leave empty for unauthenticated headless scraping
# Optional bearer token for API fallback
TWITTER_BEARER_TOKEN=

# Proxy list file path (optional; leave empty to use direct connection)
PROXY_LIST_PATH=./apps/social-mining/twitter-scraper/proxies.txt

# Keyword spike threshold (% increase to trigger alert)
KEYWORD_SPIKE_THRESHOLD=300

# Rolling window in minutes
SOCIAL_WINDOW_MINUTES=120

# --- Module 4: Scoring + Audio ---
# WebSocket server port for terminal UI
WS_PORT=3001

# Impact rating threshold for audio alert (1-10)
AUDIO_ALERT_THRESHOLD=8

# TTS speed (words per minute)
TTS_RATE=175

# --- Infrastructure ---
# Redis (used as event bus between agents)
REDIS_URL=redis://localhost:6379

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Environment: development | production
NODE_ENV=development
