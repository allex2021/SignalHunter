{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@csa/shared-types": ["../../packages/shared-types/src/index"]
    }
  },
  "include": ["src/**/*", "../../packages/shared-types/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
